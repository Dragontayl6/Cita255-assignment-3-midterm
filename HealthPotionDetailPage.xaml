<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PixelPantry.HealthPotionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Health Potion Gummies">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Border
                HeightRequest="220"
                BackgroundColor="#F3F3F3"
                Stroke="#DDDDDD">

                <Label
                    Text="🧪"
                    FontSize="100"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <Label
                Text="Health Potion Gummies"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="Black" />

            <Label
                Text="$6.99"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="In Stock"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Green" />

            <Label
                Text="Cherry-flavored gummy candies inspired by classic health potions. A fun snack for any gaming session."
                FontSize="16"
                TextColor="Gray" />

            <Label
                Text="Quantity"
                FontSize="16"
                FontAttributes="Bold" />

            <Entry
                x:Name="quantityEntry"
                Placeholder="Enter quantity"
                Keyboard="Numeric"
                FontSize="18" />

            <Button
                Text="Add to Cart"
                Clicked="AddToCart_Clicked"
                BackgroundColor="#4F46E5"
                TextColor="White"
                FontSize="18"
                HeightRequest="55" />

            <Label
                x:Name="messageLabel"
                Text=""
                FontSize="16"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>